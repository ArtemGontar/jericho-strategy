{
  "name": "jericho",
  "version": "1.0.0",
  "private": true,
  "description": "JERICHO — a Civilization-style turn-based strategy game for the browser, playable solo, hot-seat or online with friends.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "server": "tsx src/server/index.ts",
    "start": "npm run build && tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/simulate.ts",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:flat": "E2E_FLAT=1 tsx scripts/e2e.ts",
    "e2e:gl": "E2E_ONLY=gl tsx scripts/e2e.ts",
    "fuzz": "tsx scripts/fuzz.ts",
    "chaos": "tsx scripts/chaos.ts",
    "idle": "tsx scripts/idle.ts",
    "bench": "node --expose-gc --import tsx scripts/bench.ts",
    "bench:server": "node --expose-gc --import tsx scripts/serverbench.ts",
    "fingerprint": "tsx scripts/fingerprint.ts"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "three": "^0.170.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  }
}
